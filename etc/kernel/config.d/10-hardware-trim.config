# Hardware trim for: Lenovo laptop, Ryzen 7 4800H (Renoir), GTX 1660 Ti (nvidia-drivers),
# Realtek r8169 ethernet, Intel AX200 Wi-Fi/BT, 2x NVMe + AHCI, USB UVC webcam, USB audio.
#
# Merged LAST by kernel-build.eclass (after the CachyOS config and the ebuild's own tweaks),
# so anything here wins. To bring something back, delete its line and re-emerge.
#
# Kept on purpose: amdgpu (iGPU if the MUX is set to hybrid), KVM_AMD, netfilter/bridge/veth
# (docker/podman/libvirt), tun/wireguard (tailscale/twingate), CAN (modules were loaded),
# USB serial, USB ethernet dongles, joystick/HID (Steam controllers), IIO (cm32181 light sensor),
# Bluetooth, SOF/ACP AMD audio, UVC, USB storage/UAS, dm/LVM/crypt, NFS, FUSE.

## --- GPUs / accelerators you don't have ---
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_GMA500 is not set
# CONFIG_DRM_AST is not set
# CONFIG_DRM_MGAG200 is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_HYPERV is not set
# CONFIG_DRM_VBOXVIDEO is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_DRM_ACCEL is not set

## --- Running bare metal, not as a guest; Intel-only CPU features ---
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_INTEL_TDX_GUEST is not set
# CONFIG_X86_SGX is not set
# CONFIG_KVM_INTEL is not set

## --- Server / datacenter / embedded subsystems ---
# CONFIG_INFINIBAND is not set
# CONFIG_FDDI is not set
# CONFIG_NET_DSA is not set
# CONFIG_NTB is not set
# CONFIG_VDPA is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_ATA_SFF is not set
# CONFIG_PMBUS is not set
# CONFIG_W1 is not set
# 1-wire battery gauges (embedded boards); they `select W1`
# CONFIG_BATTERY_DS2780 is not set
# CONFIG_BATTERY_DS2781 is not set
# CONFIG_MTD is not set
# CONFIG_FPGA is not set
# CONFIG_MOST is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_STAGING is not set

## --- Legacy / absent buses and ports ---
# CONFIG_PCCARD is not set
# CONFIG_PARPORT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_MEMSTICK is not set
# CONFIG_USB_GADGET is not set

## --- Other vendors' platforms ---
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_MELLANOX_PLATFORM is not set
# CONFIG_X86_PLATFORM_DRIVERS_DELL is not set
# CONFIG_X86_PLATFORM_DRIVERS_HP is not set

## --- Input: no touchscreen, no NFC ---
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_NFC is not set

## --- Media: keep USB cameras (UVC), drop TV/radio/IR/PCI/platform cams ---
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_RC_CORE is not set

## --- Sound: AMD ACP/SOF + HDA + USB audio stay; Intel DSP, FireWire, PCMCIA go ---
# CONFIG_SND_SOC_INTEL_SST_TOPLEVEL is not set
# CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL is not set
# CONFIG_SND_SOC_INTEL_AVS is not set
# CONFIG_SND_SOC_INTEL_MACH is not set
# CONFIG_SND_FIREWIRE is not set
# CONFIG_SND_PCMCIA is not set

