# nvidia-drivers needs CONFIG_DRM_TTM_HELPER (with DRM_FBDEV_EMULATION), which
# can't be selected directly; some in-tree DRM driver must select it. Without
# this, the selector localmodconfig keeps is amdgpu, the biggest driver in the tree.
# QXL is tiny and never loads on bare metal. (The nvidia ebuild suggests the same.)
CONFIG_DRM_QXL=m
# CONFIG_DRM_AMDGPU is not set
#
# Side effect: with amdgpu/i915/xe all gone, nothing selects DRM_DISPLAY_HELPER /
# DRM_DISPLAY_HDCP_HELPER. nvidia-drm gates its HDCP use on
# IS_ENABLED(CONFIG_DRM_DISPLAY_HDCP_HELPER) and builds without the
# "Content Protection" connector property. Nothing else it imports comes from there.

# Intel QuickAssist crypto accelerator: kept by localmodconfig's selector logic,
# but this is an AMD laptop.
# CONFIG_CRYPTO_DEV_QAT_DH895xCC is not set
# CONFIG_CRYPTO_DEV_QAT_DH895xCCVF is not set
# CONFIG_CRYPTO_DEV_QAT is not set
