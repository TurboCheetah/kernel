# Drop DWARF debug info. The ebuild strips (USE=strip) anyway, so the debug info
# is generated and then thrown away. It's one of the most expensive parts of a
# ThinLTO kernel build (bigger objects, slower LTO link, pahole BTF pass per module).
#
# Side effect: DEBUG_INFO_BTF goes away, and with it CONFIG_SCHED_CLASS_EXT
# (sched_ext / scx schedulers) and BPF CO-RE tools (bpftrace, bcc). None of
# those are installed on this machine. Delete this file if you start using them.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
